{
    "name": "pmzedx/steam-service",
    "description": "A clean PHP wrapper for the Steam Web API using Guzzle HTTP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "steam",
        "api",
        "steam-api",
        "valve",
        "guzzle"
    ],
    "autoload": {
        "psr-4": {
            "PmZedx\\SteamService\\": "src/"
        }
    },
    "authors": [
        {
            "name": "peimanmahdavi",
            "email": "peimanmahdavi9@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "suggest": {
        "ext-http": "Provides optional HTTP client features via PECL extension"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
